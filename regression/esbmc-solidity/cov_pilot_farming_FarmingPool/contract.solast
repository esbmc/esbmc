et","valueSize":1},{"declaration":672,"isOffset":true,"isSlot":false,"src":"35414:13:0","suffix":"offset","valueSize":1},{"declaration":672,"isOffset":true,"isSlot":false,"src":"35540:13:0","suffix":"offset","valueSize":1},{"declaration":672,"isOffset":true,"isSlot":false,"src":"35948:13:0","suffix":"offset","valueSize":1},{"declaration":672,"isOffset":true,"isSlot":false,"src":"36345:13:0","suffix":"offset","valueSize":1},{"declaration":678,"isOffset":false,"isSlot":false,"src":"35767:7:0","valueSize":1},{"declaration":678,"isOffset":false,"isSlot":false,"src":"36153:7:0","valueSize":1},{"declaration":695,"isOffset":false,"isSlot":false,"src":"34134:15:0","valueSize":1},{"declaration":695,"isOffset":false,"isSlot":false,"src":"35886:15:0","valueSize":1},{"declaration":683,"isOffset":false,"isSlot":false,"src":"30008:14:0","valueSize":1},{"declaration":683,"isOffset":false,"isSlot":false,"src":"33157:14:0","valueSize":1},{"declaration":670,"isOffset":false,"isSlot":false,"src":"30148:7:0","valueSize":1},{"declaration":670,"isOffset":false,"isSlot":false,"src":"31672:7:0","valueSize":1},{"declaration":670,"isOffset":false,"isSlot":false,"src":"34851:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"31380:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"33013:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"33423:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"33852:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"35744:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"36130:7:0","valueSize":1},{"declaration":675,"isOffset":false,"isSlot":false,"src":"36545:7:0","valueSize":1},{"declaration":666,"isOffset":false,"isSlot":false,"src":"31403:5:0","valueSize":1},{"declaration":666,"isOffset":false,"isSlot":false,"src":"33036:5:0","valueSize":1},{"declaration":666,"isOffset":false,"isSlot":false,"src":"33446:5:0","valueSize":1},{"declaration":666,"isOffset":false,"isSlot":false,"src":"33875:5:0","valueSize":1},{"declaration":666,"isOffset":false,"isSlot":false,"src":"34270:5:0","valueSize":1},{"declaration":666,"isOffset":false,"isSlot":false,"src":"36568:5:0","valueSize":1}],"flags":["memory-safe"],"id":706,"nodeType":"InlineAssembly","src":"29687:6948:0"}]},"documentation":{"id":663,"nodeType":"StructuredDocumentation","src":"27645:1535:0","text":" @notice The function attempts to call the permit function on a given ERC20 token.\n @dev The function is designed to support a variety of permit functions, namely: IERC20Permit, IDaiLikePermit, IERC7597Permit and IPermit2.\n It accommodates both Compact and Full formats of these permit types.\n Please note, it is expected that the `expiration` parameter for the compact Permit2 and the `deadline` parameter\n for the compact Permit are to be incremented by one before invoking this function. This approach is motivated by\n gas efficiency considerations; as the unlimited expiration period is likely to be the most common scenario, and\n zeros are cheaper to pass in terms of gas cost. Thus, callers should increment the expiration or deadline by one\n before invocation for optimized performance.\n Note that the implementation does not perform dirty bits cleaning, so it is the responsibility of\n the caller to make sure that the higher 96 bits of the `owner` and `spender` parameters are clean.\n @param token The address of the ERC20 token on which to call the permit function.\n @param owner The owner of the tokens. This address should have signed the off-chain permit.\n @param spender The address which will be approved for transfer of tokens.\n @param permit The off-chain permit data, containing different fields depending on the type of permit function.\n @return success A boolean indicating whether the permit call was successful."},"id":708,"implemented":true,"kind":"function","modifiers":[],"name":"tryPermit","nameLocation":"29194:9:0","nodeType":"FunctionDefinition","parameters":{"id":673,"nodeType":"ParameterList","parameters":[{"constant":false,"id":666,"mutability":"mutable","name":"token","nameLocation":"29211:5:0","nodeType":"VariableDeclaration","scope":708,"src":"29204:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$77","typeString":"contract IERC20"},"typeName":{"id":665,"nodeType":"UserDefinedTypeName","pathNode":{"id":664,"name":"IERC20","nameLocations":["29204:6:0"],"nodeType":"IdentifierPath","referencedDeclaration":77,"src":"29204:6:0"},"referencedDeclaration":77,"src":"29204:6:0","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$77","typeString":"contract IERC20"}},"visibility":"internal"},{"constant":false,"id":668,"mutability":"mutable","name":"owner","nameLocation":"29226:5:0","nodeType":"VariableDeclaration","scope":708,"src":"29218:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":667,"name":"address","nodeType":"ElementaryTypeName","src":"29218:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":670,"mutability":"mutable","name":"spender","nameLocation":"29241:7:0","nodeType":"VariableDeclaration","scope":708,"src":"29233:15:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":669,"name":"address","nodeType":"ElementaryTypeName","src":"29233:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":672,"mutability":"mutable","name":"permit","nameLocation":"29265:6:0","nodeType":"VariableDeclaration","scope":708,"src":"29250:21:0","stateVariable":false,"storageLocation":"calldata","typeDescriptions":{"typeI