rue,"isSlot":false,"src":"81189:13:0","suffix":"offset","valueSize":1},{"declaration":2648,"isOffset":false,"isSlot":false,"src":"80611:7:0","valueSize":1},{"declaration":2648,"isOffset":false,"isSlot":false,"src":"80997:7:0","valueSize":1},{"declaration":2665,"isOffset":false,"isSlot":false,"src":"78978:15:0","valueSize":1},{"declaration":2665,"isOffset":false,"isSlot":false,"src":"80730:15:0","valueSize":1},{"declaration":2653,"isOffset":false,"isSlot":false,"src":"74852:14:0","valueSize":1},{"declaration":2653,"isOffset":false,"isSlot":false,"src":"78001:14:0","valueSize":1},{"declaration":2640,"isOffset":false,"isSlot":false,"src":"74992:7:0","valueSize":1},{"declaration":2640,"isOffset":false,"isSlot":false,"src":"76516:7:0","valueSize":1},{"declaration":2640,"isOffset":false,"isSlot":false,"src":"79695:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"76224:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"77857:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"78267:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"78696:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"80588:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"80974:7:0","valueSize":1},{"declaration":2645,"isOffset":false,"isSlot":false,"src":"81389:7:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"76247:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"77880:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"78290:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"78719:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"79114:5:0","valueSize":1},{"declaration":2636,"isOffset":false,"isSlot":false,"src":"81412:5:0","valueSize":1}],"flags":["memory-safe"],"id":2676,"nodeType":"InlineAssembly","src":"74531:6948:0"}]},"documentation":{"id":2633,"nodeType":"StructuredDocumentation","src":"72489:1535:0","text":" @notice The function attempts to call the permit function on a given ERC20 token.\n @dev The function is designed to support a variety of permit functions, namely: IERC20Permit, IDaiLikePermit, IERC7597Permit and IPermit2.\n It accommodates both Compact and Full formats of these permit types.\n Please note, it is expected that the `expiration` parameter for the compact Permit2 and the `deadline` parameter\n for the compact Permit are to be incremented by one before invoking this function. This approach is motivated by\n gas efficiency considerations; as the unlimited expiration period is likely to be the most common scenario, and\n zeros are cheaper to pass in terms of gas cost. Thus, callers should increment the expiration or deadline by one\n before invocation for optimized performance.\n Note that the implementation does not perform dirty bits cleaning, so it is the responsibility of\n the caller to make sure that the higher 96 bits of the `owner` and `spender` parameters are clean.\n @param token The address of the ERC20 token on which to call the permit function.\n @param owner The owner of the tokens. This address should have signed the off-chain permit.\n @param spender The address which will be approved for transfer of tokens.\n @param permit The off-chain permit data, containing different fields depending on the type of permit function.\n @return success A boolean indicating whether the permit call was successful."},"id":2678,"implemented":true,"kind":"function","modifiers":[],"name":"tryPermit","nameLocation":"74038:9:0","nodeType":"FunctionDefinition","parameters":{"id":2643,"nodeType":"ParameterList","parameters":[{"constant":false,"id":2636,"mutability":"mutable","name":"token","nameLocation":"74055:5:0","nodeType":"VariableDeclaration","scope":2678,"src":"74048:12:0","stateVariable":false,"storageLocation":"default","typeDescrip