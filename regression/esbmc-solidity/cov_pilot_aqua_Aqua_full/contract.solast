,"name":"IPermit2","nameLocation":"19145:8:0","nodeType":"ContractDefinition","nodes":[{"canonicalName":"IPermit2.PermitDetails","documentation":{"id":365,"nodeType":"StructuredDocumentation","src":"19160:356:0","text":" @dev Struct for holding permit details.\n @param token ERC20 token address for which the permit is issued.\n @param amount The maximum amount allowed to spend.\n @param expiration Timestamp until which the permit is valid.\n @param nonce An incrementing value for each signature, unique per owner, token, and spender."},"id":374,"members":[{"constant":false,"id":367,"mutability":"mutable","name":"token","nameLocation":"19560:5:0","nodeType":"VariableDeclaration","scope":374,"src":"19552:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"},"typeName":{"id":366,"name":"address","nodeType":"ElementaryTypeName","src":"19552:7:0","stateMutability":"nonpayable","typeDescriptions":{"typeIdentifier":"t_address","typeString":"address"}},"visibility":"internal"},{"constant":false,"id":369,"mutability":"mutable","name":"amount","nameLocation":"19583:6:0","nodeType":"VariableDeclaration","scope":374,"src":"19575:14:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"},"typeName":{"id":368,"name":"uint160","nodeType":"ElementaryTypeName","src":"19575:7:0","typeDescriptions":{"typeIdentifier":"t_uint160","typeString":"uint160"}},"visibility":"internal"},{"constant":false,"id":371,"mutability":"mutable","name":"expiration","nameLocation":"19606:10:0","nodeType":"VariableDeclaration","scope":374,"src":"19599:17:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"},"typeName":{"id":370,"name":"uint48","nodeType":"ElementaryTypeName","src":"19599:6:0","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"}},"visibility":"internal"},{"constant":false,"id":373,"mutability":"mutable","name":"nonce","nameLocation":"19633:5:0","nodeType":"VariableDeclaration","scope":374,"src":"19626:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"},"typeName":{"id":372,"name":"uint48","nodeType":"ElementaryTypeName","src":"19626:6:0","typeDescriptions":{"typeIdentifier":"t_uint48","typeString":"uint48"}},"visibility":"internal"}],"name":"PermitDetails","nameLocation":"19528:13:0","nodeType":"StructDefinition","scope":440,"src":"19521:124:0","visibility":"public"},{"canonicalName":"IPermit2.PermitSingle","documentation":{"id":375,"nodeType":"StructuredDocumentation","src":"19651:310:0","text":" @dev Struct for a single token allowance permit.\n @param details Permit details including token, amount, expiration, and nonce.\n @param spender Address authorized to spend the tokens.\n @param sigDeadline Deadline for the permit signature, ensuring timeliness of the permit."},"id":383,"members":[{"constant":false,"id":378,"mutability":"mutable","name":"details","nameLocation":"20010:7:0","nodeType":"VariableDeclaration","scope":383,"src":"19996:21:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_struct$_PermitDetails_$374_storage_ptr","typeString":"struct IPermit2.PermitDetails"},"typeName":{"id":377,"nodeType":"UserDefinedTypeName","pathNode":{"id":376,"name":"PermitDetails","nameLocations":["19996:13:0"],"nodeType":"IdentifierPath","referencedDeclaration":374,"src":"19996:13:0"},"referencedDeclaration":374,"src":"19996:13:0","typeDescriptions":{"typeIdentifier":"t_struct$_PermitDetails_$374_storage_ptr","typeString":"struct IPermit2.PermitDetails"}},"visibility":"internal"},{"constant":false,"id":380,"mutability":"mutable","name":"spender","nameLocation":"20035:7:0","nodeType":"VariableDeclaration","scope":383,"src":"20027:15:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentif