ions\n 3. forceApprove functionality\n 4. support for WETH deposit and withdraw"},"fullyImplemented":true,"id":1299,"linearizedBaseContracts":[1299],"name":"SafeERC20","nameLocation":"16041:9:0","nodeType":"ContractDefinition","nodes":[{"errorSelector":"fb7f5079","id":804,"name":"SafeTransferFailed","nameLocation":"16063:18:0","nodeType":"ErrorDefinition","parameters":{"id":803,"nodeType":"ParameterList","parameters":[],"src":"16081:2:0"},"src":"16057:27:0"},{"errorSelector":"f4059071","id":806,"name":"SafeTransferFromFailed","nameLocation":"16095:22:0","nodeType":"ErrorDefinition","parameters":{"id":805,"nodeType":"ParameterList","parameters":[],"src":"16117:2:0"},"src":"16089:31:0"},{"errorSelector":"19be9a90","id":808,"name":"ForceApproveFailed","nameLocation":"16131:18:0","nodeType":"ErrorDefinition","parameters":{"id":807,"nodeType":"ParameterList","parameters":[],"src":"16149:2:0"},"src":"16125:27:0"},{"errorSelector":"8216cd1c","id":810,"name":"SafeIncreaseAllowanceFailed","nameLocation":"16163:27:0","nodeType":"ErrorDefinition","parameters":{"id":809,"nodeType":"ParameterList","parameters":[],"src":"16190:2:0"},"src":"16157:36:0"},{"errorSelector":"840bdf26","id":812,"name":"SafeDecreaseAllowanceFailed","nameLocation":"16204:27:0","nodeType":"ErrorDefinition","parameters":{"id":811,"nodeType":"ParameterList","parameters":[],"src":"16231:2:0"},"src":"16198:36:0"},{"errorSelector":"68275857","id":814,"name":"SafePermitBadLength","nameLocation":"16245:19:0","nodeType":"ErrorDefinition","parameters":{"id":813,"nodeType":"ParameterList","parameters":[],"src":"16264:2:0"},"src":"16239:28:0"},{"errorSelector":"8112e119","id":816,"name":"Permit2TransferAmountTooHigh","nameLocation":"16278:28:0","nodeType":"ErrorDefinition","parameters":{"id":815,"nodeType":"ParameterList","parameters":[],"src":"16306:2:0"},"src":"16272:37:0"},{"constant":true,"id":819,"mutability":"constant","name":"_PERMIT2","nameLocation":"16371:8:0","nodeType":"VariableDeclaration","scope":1299,"