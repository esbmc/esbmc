c":"59094:2:0","typeDescriptions":{"typeIdentifier":"t_rational_18_by_1","typeString":"int_const 18"},"value":"18"},"functionReturnParameters":1797,"id":1799,"nodeType":"Return","src":"59087:9:0"}]},"documentation":{"id":1793,"nodeType":"StructuredDocumentation","src":"58394:622:0","text":" @dev Returns the number of decimals used to get its user representation.\n For example, if `decimals` equals `2`, a balance of `505` tokens should\n be displayed to a user as `5.05` (`505 / 10 ** 2`).\n Tokens usually opt for a value of 18, imitating the relationship between\n Ether and Wei. This is the default value returned by this function, unless\n it's overridden.\n NOTE: This information is only used for _display_ purposes: it in\n no way affects any of the arithmetic of the contract, including\n {IERC20-balanceOf} and {IERC20-transfer}."},"functionSelector":"313ce567","id":1801,"implemented":true,"kind":"function","modifiers":[],"name":"decimals","nameLocation":"59030:8:0","nodeType":"FunctionDefinition","parameters":{"id":1794,"nodeType":"ParameterList","parameters":[],"src":"59038:2:0"},"returnParameters":{"id":1797,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1796,"mutability":"mutable","name":"","nameLocation":"-1:-1:-1","nodeType":"VariableDeclaration","scope":1801,"src":"59070:5:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"},"typeName":{"id":1795,"name":"uint8","nodeType":"ElementaryTypeName","src":"59070:5:0","typeDescriptions":{"typeIdentifier":"t_uint8","typeString":"uint8"}},"visibility":"internal"}],"src":"59069:7:0"},"scope":2237,"src":"59021:82:0","stateMutability":"view","virtual":true,"visibility":"public"},{"baseFunctions":[26],"body":{"id":1809,"nodeType":"Block","src":"59224:36:0","statements":[{"expression":{"id":1807,"name":"_totalSupply","nodeType":"Identifier","overloadedDeclarations":[],"referencedDeclaration":1753,"src":"59241:12:0","typeDescriptions":{"typ