}}]},"documentation":{"id":1132,"nodeType":"StructuredDocumentation","src":"26968:837:0","text":" @notice Attempts to execute the `permit` function on the provided token with custom owner and spender parameters.\n Permit type is determined automatically based on permit calldata (IERC20Permit, IDaiLikePermit, and IPermit2).\n @dev Wraps `tryPermit` function and forwards revert reason if permit fails.\n Note that the implementation does not perform dirty bits cleaning, so it is the responsibility of\n the caller to make sure that the higher 96 bits of the `owner` and `spender` parameters are clean.\n @param token The IERC20 token to execute the permit function on.\n @param owner The owner of the tokens for which the permit is made.\n @param spender The spender allowed to spend the tokens by the permit.\n @param permit The permit data to be used in the function call."},"id":1158,"implemented":true,"kind":"function","modifiers":[],"name":"safePermit","nameLocation":"27819:10:0","nodeType":"FunctionDefinition","parameters":{"id":1142,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1135,"mutability":"mutable","name":"token","nameLocation":"27837:5:0","nodeType":"VariableDeclaration","scope":1158,"src":"27830:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$77","typeString":"contract IERC20"},"typeName":{"id":1134,"nodeType":"UserDefinedTypeName","pathNode":{"id":1133,"name":"IERC20","nameLocations":["27830:6:0"],"nodeType":"IdentifierPath","referencedDeclaration":77,"src":"27830:6:0"},"referencedDeclaration":77,"src":"27830:6:0","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$77","typeString":"contract IERC20"}},"visibility":"internal"},{"constant":false,"id":1137,"mutability":"mutable","name":"owner","nameLocation":"27852:5:0","nodeType":"VariableDeclaration","scope":1158,"src":"27844:13:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_ad