15:0","valueSize":1},{"declaration":1380,"isOffset":false,"isSlot":false,"src":"57361:15:0","valueSize":1},{"declaration":1368,"isOffset":false,"isSlot":false,"src":"51483:14:0","valueSize":1},{"declaration":1368,"isOffset":false,"isSlot":false,"src":"54632:14:0","valueSize":1},{"declaration":1355,"isOffset":false,"isSlot":false,"src":"51623:7:0","valueSize":1},{"declaration":1355,"isOffset":false,"isSlot":false,"src":"53147:7:0","valueSize":1},{"declaration":1355,"isOffset":false,"isSlot":false,"src":"56326:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"52855:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"54488:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"54898:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"55327:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"57219:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"57605:7:0","valueSize":1},{"declaration":1360,"isOffset":false,"isSlot":false,"src":"58020:7:0","valueSize":1},{"declaration":1351,"isOffset":false,"isSlot":false,"src":"52878:5:0","valueSize":1},{"declaration":1351,"isOffset":false,"isSlot":false,"src":"54511:5:0","valueSize":1},{"declaration":1351,"isOffset":false,"isSlot":false,"src":"54921:5:0","valueSize":1},{"declaration":1351,"isOffset":false,"isSlot":false,"src":"55350:5:0","valueSize":1},{"declaration":1351,"isOffset":false,"isSlot":false,"src":"55745:5:0","valueSize":1},{"declaration":1351,"isOffset":false,"isSlot":false,"src":"58043:5:0","valueSize":1}],"flags":["memory-safe"],"id":1391,"nodeType":"InlineAssembly","src":"51162:6948:0"}]},"documentation":{"id":1348,"nodeType":"StructuredDocumentation","src":"49120:1535:0","text":" @notice The function attempts to call the permit function on a given ERC20 token.\n @dev The function is designed to support a variety of permit functions, namely: IERC20Permit, IDaiLikePermit, IERC7597Permit and IPermit2.\n It accommodates both Compact and Full formats of these permit types.\n Please note, it is expected that the `expiration` parameter for the compact Permit2 and the `deadline` parameter\n for the compact Permit are to be incremented by one before invoking this function. This approach is motivated by\n gas efficiency considerations; as the unlimited expiration period is likely to be the most common scenario, and\n zeros are cheaper to pass in terms of gas cost. Thus, callers should increment the expiration or deadline by one\n before invocation for optimized performance.\n Note that the implementation does not perform dirty bits cleaning, so it is the responsibility of\n the caller to make sure that the higher 96 bits of the `owner` and `spender` parameters are clean.\n @param token The address of the ERC20 token on which to call the permit function.\n @param owner The owner of the tokens. This address should have signed the off-chain permit.\n @param spender The address which will be approved for transfer of tokens.\n @param permit The off-chain permit data, containing different fields depending on the type of permit function.\n @return success A boolean indicating whether the permit call was successful."},"id":1393,"implemented":true,"kind":"function","modifiers":[],"name":"tryPermit","nameLocation":"50669:9:0","nodeType":"FunctionDefinition","parameters":{"id":1358,"nodeType":"ParameterList","parameters":[{"constant":false,"id":1351,"mutability":"mutable","name":"token","nameLocation":"50686:5:0","nodeType":"VariableDeclaration","scope":1393,"src":"50679:12:0","stateVariable":false,"storageLocation":"default","typeDescriptions":{"typeIdentifier":"t_contract$_IERC20_$220","typeString":"contract IERC20"},"typeName":{"id":1350,"nodeType":"UserDefinedTypeName","pathNode":{"id":1349,"name":"IERC20","nameLocations":["50679:6:0"],"nodeType":"IdentifierPath","referencedDeclaration":220,"src":"50679:6:0"},"referencedDeclaration":2