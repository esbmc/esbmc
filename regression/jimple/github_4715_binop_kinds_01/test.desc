CORE
main.jimple
--irep2-bodies --force-malloc-success --goto-functions-only
^ +ASSIGN \$i0=\$i1\ \+\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ \-\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ \*\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ /\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ %\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ <\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ <=\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ >\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ >=\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ ==\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ ==\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\$i1\ !=\ 2\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\(_Bool\)\$i1\ \&\&\ 1\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\(signed\ int\)\(\(_Bool\)\$i1\ \|\|\ 1\);\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ \&\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ \|\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ \^\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ <<\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ >>\ 2;\n +// \d+[^\n]*\n +ASSIGN \$i0=\$i1\ >>\ 2;$
