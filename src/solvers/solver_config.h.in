/* Which solver backends were built in. Named ESBMC_ENABLE_* rather than bare
 * Z3/SMTLIB/... because those bare names collide with camada's SMTBackendKind
 * enumerators wherever both headers are visible, which made the include order
 * in solve.cpp load-bearing. */

#define ESBMC_ENABLE_z3 @ESBMC_ENABLE_z3@
#define ESBMC_ENABLE_cvc5 @ESBMC_ENABLE_cvc5@
#define ESBMC_ENABLE_mathsat @ESBMC_ENABLE_mathsat@
#define ESBMC_ENABLE_yices @ESBMC_ENABLE_yices@
#define ESBMC_ENABLE_bitwuzla @ESBMC_ENABLE_bitwuzla@
#define ESBMC_ENABLE_smtlib @ESBMC_ENABLE_smtlib@
