// Which occurrences were replaced is as nondeterministic as the match, so the
// result is unconstrained rather than the subject echoed back: echoing it
// would prove `result == input` for a subject the pattern does match.
template <class CharT, class ST, class SA, class Traits>
basic_string<CharT, ST, SA> regex_replace(
  const basic_string<CharT, ST, SA> &,
  const basic_regex<CharT, Traits> &,
  const CharT *,
  regex_constants::match_flag_type = regex_constants::match_default)
{
  return __regex_detail::nondet_text<basic_string<CharT, ST, SA>>();
}

template <class CharT, class ST, class SA, class Traits>
basic_string<CharT, ST, SA> regex_replace(
  const basic_string<CharT, ST, SA> &,
  const basic_regex<CharT, Traits> &,
  const basic_string<CharT, ST, SA> &,
  regex_constants::match_flag_type = regex_constants::match_default)
{
  return __regex_detail::nondet_text<basic_string<CharT, ST, SA>>();
}

template <class CharT, class Traits>
basic_string<CharT> regex_replace(
  const CharT *,
  const basic_regex<CharT, Traits> &,
  const CharT *,
  regex_constants::match_flag_type = regex_constants::match_default)
{
  return __regex_detail::nondet_text<basic_string<CharT>>();
}

