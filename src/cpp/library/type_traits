// decay
template <class T>
struct decay
{
private:
  typedef typename remove_reference<T>::type U;
  typedef typename conditional<
    false /* is_function<U> */,
    U *,
    typename remove_cv<U>::type>::type non_array_type;

public:
  typedef typename conditional<
    is_array<U>::value,
    typename remove_extent<U>::type *,
    non_array_type>::type type;
};

