// remove_volatile / add_const: the members of the cv family that were missing
// next to their already-present siblings. add_lvalue_reference already comes
// from <utility>, which this header includes.
template <class T>
struct remove_volatile
{
  typedef T type;
};
template <class T>
struct remove_volatile<volatile T>
{
  typedef T type;
};

template <class T>
struct add_const
{
  typedef const T type;
};

// [meta.trans.cv]: the other two of the trio.
template <class T>
struct add_volatile
{
  typedef volatile T type;
};

template <class T>
struct add_cv
{
  typedef const volatile T type;
};

// [meta.trans.arr]: remove_extent's recursive sibling. remove_extent itself
// comes from <utility>, which this header includes.
template <class T>
struct remove_all_extents
{
  typedef T type;
};
template <class T>
struct remove_all_extents<T[]>
{
  typedef typename remove_all_extents<T>::type type;
};
template <class T, size_t _Np>
struct remove_all_extents<T[_Np]>
{
  typedef typename remove_all_extents<T>::type type;
};

