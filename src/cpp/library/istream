// As with ostream, the spec says that these functions are explicitly
// declared and defined, not templated.
istream &operator>>(istream &is, bool &val)
{
  dec(is);
  if (val == 1)
  {
    boolalpha(is);
  }
  val = nondet_bool();
  is._gcount = 0;
  return is;
}
