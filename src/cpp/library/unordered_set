#ifndef ESBMC_UNORDERED_SET_H
#define ESBMC_UNORDERED_SET_H

// Post-C++03 header: inert in older modes, matching libstdc++/libc++ (#3387).
#if __cplusplus >= 201103L

#include <initializer_list>
#include <utility>
#include <memory> /* std::allocator, for the Allocator parameter */

namespace std {

#ifndef SIZE_MAX
#define SIZE_MAX ((size_t)-1)
#endif

// Simple hash function
template<typename T>
struct esbmc_hash {
    size_t operator()(const T& key) const {
        return static_cast<size_t>(key);
    }
};

// Simple equality comparison
template<typename T>
struct esbmc_equal_to {
    bool operator()(const T& lhs, const T& rhs) const {
        return lhs == rhs;
    }
};

// Forward declaration
// [unord.set.overview]: the Allocator parameter completes the signature. The
// fixed array below does the allocating, so it is carried for the signature and
// the allocator_type typedef only.
template<typename Key, typename Hash = esbmc_hash<Key>,
         typename KeyEqual = esbmc_equal_to<Key>,
         typename Allocator = allocator<Key>>
class unordered_set;

// Simple array-based implementation - much simpler than hash table
template<typename Key, typename Hash, typename KeyEqual>
class esbmc_unordered_set_iterator {
public:
    typedef Key value_type;
    typedef const Key& reference;
    typedef const Key* pointer;
    typedef ptrdiff_t difference_type;

    // Grant friend access to unordered_set
    friend class unordered_set<Key, Hash, KeyEqual>;

private:
    const Key* data_;
    const unsigned long long* dead_;
    size_t pos_;
    size_t size_;

public:
    // Constructors
    esbmc_unordered_set_iterator()
        : data_(nullptr), dead_(nullptr), pos_(0), size_(0) {}

    esbmc_unordered_set_iterator(const Key* data, const unsigned long long* dead,
                                 size_t position, size_t size)
        : data_(data), dead_(dead), pos_(position), size_(size) {}

    // Dereference operators
    reference operator*() const {
        return data_[pos_];
    }
    
    pointer operator->() const {
        return &data_[pos_];
    }

    // Increment operators
    esbmc_unordered_set_iterator& operator++() {
        if (pos_ < size_) {
            ++pos_;
            while (pos_ < size_ && ((*dead_ >> pos_) & 1)) {
                ++pos_;
            }
        }
        return *this;
    }
    
    esbmc_unordered_set_iterator operator++(int) {
        esbmc_unordered_set_iterator temp = *this;
        ++(*this);
        return temp;
    }

    // Comparison operators
    bool operator==(const esbmc_unordered_set_iterator& other) const {
        return data_ == other.data_ && pos_ == other.pos_;
    }
    
    bool operator!=(const esbmc_unordered_set_iterator& other) const {
        return !(*this == other);
    }
};

// Simple unordered_set implementation using fixed-size array
template<typename Key, typename Hash, typename KeyEqual, typename Allocator>
class unordered_set {
public:
    // Type definitions
    typedef Key key_type;
    typedef Key value_type;
    typedef Hash hasher;
    typedef KeyEqual key_equal;
    typedef Allocator allocator_type;
    typedef value_type& reference;
    typedef const value_type& const_reference;
    typedef value_type* pointer;
    typedef const value_type* const_pointer;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;
    
    typedef esbmc_unordered_set_iterator<Key, Hash, KeyEqual> iterator;
    typedef esbmc_unordered_set_iterator<Key, Hash, KeyEqual> const_iterator;

private:
    // TODO: Implement a hash table if needed.
    // Simple fixed-size array storage
    /* 64, matching <unordered_map> and unordered_multiset below, for the
     * reason <unordered_map> records: with std::string's inline buffer, 1024
     * slots made one container ~140KB and solver encodings timed out. At 1024
     * an unordered_set<std::string> could not be executed at all. */
    static const size_t MAX_SIZE = 64;
    // [unord.req]: erase invalidates only the erased elements, so erase
    // sets the slot's bit in dead_ instead of moving the later elements down
    // (one bit per slot, so MAX_SIZE is at most 64). size_ counts the slots
    // in use, erased ones included; erased_ the erased ones.
    Key data_[MAX_SIZE];
    size_type size_;
    size_type erased_;
    unsigned long long dead_;
    hasher hash_function_;
    key_equal equal_function_;

    // Find index of key, or MAX_SIZE if not found
    size_type find_index(const Key& key) const {
        for (size_type i = 0; i < size_; ++i) {
            if (is_live(i) && equal_function_(data_[i], key)) {
                return i;
            }
        }
        return MAX_SIZE;
    }

    bool is_live(size_type i) const {
        return !((dead_ >> i) & 1);
    }

    size_type first_live(size_type i) const {
        while (i < size_ && !is_live(i)) {
            ++i;
        }
        return i;
    }

    // Only called with an erased slot, so dead_ is nonzero.
    size_type first_dead() const {
        return __builtin_ctzll(dead_);
    }

    iterator make_iterator(size_type idx) const {
        return iterator(data_, &dead_, idx, size_);
    }

    void copy_elements(const unordered_set& other) {
        size_ = other.size_;
        erased_ = other.erased_;
        dead_ = other.dead_;
        for (size_type i = 0; i < size_; ++i) {
            data_[i] = other.data_[i];
        }
    }

public:
    // Constructors
    unordered_set() : size_(0), erased_(0), dead_(0) {}

    ~unordered_set() { size_ = 0; }

    explicit unordered_set(size_type /*bucket_count*/)
        : size_(0), erased_(0), dead_(0) {}

    unordered_set(std::initializer_list<value_type> init)
        : size_(0), erased_(0), dead_(0) {
        insert(init.begin(), init.end());
    }
    
    // Iterator range constructor
    template<typename InputIterator>
    unordered_set(InputIterator first, InputIterator last)
        : size_(0), erased_(0), dead_(0) {
        insert(first, last);
    }
    
    // Copy constructor
    unordered_set(const unordered_set& other) 
        : hash_function_(other.hash_function_), 
          equal_function_(other.equal_function_) {
        copy_elements(other);
    }
    
    // Move constructor
    unordered_set(unordered_set&& other) noexcept
        : hash_function_(other.hash_function_), 
          equal_function_(other.equal_function_) {
        copy_elements(other);
        other.clear();
    }

    // Assignment operators
    unordered_set& operator=(const unordered_set& other) {
        if (this != &other) {
            hash_function_ = other.hash_function_;
            equal_function_ = other.equal_function_;
            copy_elements(other);
        }
        return *this;
    }
    
    unordered_set& operator=(unordered_set&& other) noexcept {
        if (this != &other) {
            hash_function_ = other.hash_function_;
            equal_function_ = other.equal_function_;
            copy_elements(other);
            other.clear();
        }
        return *this;
    }

    // Iterators
    iterator begin() {
        return make_iterator(first_live(0));
    }
    
    const_iterator begin() const {
        return make_iterator(first_live(0));
    }
    
    iterator end() {
        return make_iterator(size_);
    }
    
    const_iterator end() const {
        return make_iterator(size_);
    }
    
    const_iterator cbegin() const {
        return begin();
    }
    
    const_iterator cend() const {
        return end();
    }

    // Capacity
    bool empty() const noexcept {
        return size_ == erased_;
    }
    
    size_type size() const noexcept {
        return size_ - erased_;
    }
    
    size_type max_size() const noexcept {
        return MAX_SIZE;
    }

    // Modifiers
    
    // Insert single element
    std::pair<iterator, bool> insert(const Key& key) {
        size_type idx = find_index(key);
        if (idx != MAX_SIZE) {
            // Already exists
            return std::make_pair(make_iterator(idx), false);
        }
        
        // Reuse an erased slot, or append one.
        size_type slot = erased_ == 0 ? size_ : first_dead();
        if (slot == size_) {
            __ESBMC_assert(size_ < MAX_SIZE, "unordered_set capacity exceeded");
            ++size_;
        } else {
            dead_ &= ~(1ULL << slot);
            --erased_;
        }
        data_[slot] = key;
        return std::make_pair(make_iterator(slot), true);
    }
    
    // Insert with move semantics
    std::pair<iterator, bool> insert(Key&& key) {
        return insert(key);
    }
    
    // Insert range
    template<typename InputIterator>
    void insert(InputIterator first, InputIterator last) {
        for (InputIterator it = first; it != last; ++it) {
            insert(*it);
        }
    }
    
    // Emplace
    template<typename... Args>
    std::pair<iterator, bool> emplace(Args&&... args) {
        Key key(args...);
        return insert(key);
    }
    
    // Erase by key
    size_type erase(const Key& key) {
        size_type idx = find_index(key);
        if (idx == MAX_SIZE) {
            return 0; // Not found
        }
        
        dead_ |= 1ULL << idx;
        ++erased_;
        return 1;
    }
    
    // Erase by iterator
    iterator erase(const_iterator position) {
        if (position == end()) {
            return end();
        }
        
        size_type idx = position.pos_;
        if (idx >= size_ || !is_live(idx)) {
            return end();
        }
        
        dead_ |= 1ULL << idx;
        ++erased_;
        return make_iterator(first_live(idx + 1));
    }
    
    // Erase range
    iterator erase(const_iterator first, const_iterator last) {
        size_type end_idx = last.pos_ < size_ ? last.pos_ : size_;
        for (size_type i = first.pos_; i < end_idx; ++i) {
            if (is_live(i)) {
                dead_ |= 1ULL << i;
                ++erased_;
            }
        }
        return make_iterator(end_idx);
    }
    
    // Clear all elements
    void clear() noexcept {
        size_ = 0;
        erased_ = 0;
        dead_ = 0;
    }

    // Lookup operations
    
    // Find element
    iterator find(const Key& key) {
        size_type idx = find_index(key);
        if (idx != MAX_SIZE) {
            return make_iterator(idx);
        }
        return end();
    }
    
    const_iterator find(const Key& key) const {
        size_type idx = find_index(key);
        if (idx != MAX_SIZE) {
            return make_iterator(idx);
        }
        return end();
    }
    
    // Count occurrences (0 or 1 for set)
    size_type count(const Key& key) const {
        return find_index(key) != MAX_SIZE ? 1 : 0;
    }
    
    // Check if key exists (C++20)
    bool contains(const Key& key) const {
        return find_index(key) != MAX_SIZE;
    }

    // Bucket interface
    size_type bucket_count() const noexcept {
        return 1;
    }
    
    size_type bucket_size(size_type /*bucket_index*/) const {
        return size_ - erased_;
    }
    
    size_type bucket(const Key& /*key*/) const {
        return 0;
    }

    // Hash policy
    double load_factor() const noexcept {
        return static_cast<double>(size_ - erased_) / MAX_SIZE;
    }
    
    double max_load_factor() const noexcept {
        return 1.0;
    }
    
    void reserve(size_type /*count*/) {
        // No-op for fixed-size array
    }

    // Observers
    hasher hash_function() const {
        return hash_function_;
    }
    
    key_equal key_eq() const {
        return equal_function_;
    }

    // Comparison operators
    bool operator==(const unordered_set& other) const {
        if (size() != other.size()) {
            return false;
        }
        
        // Check that all elements in this set exist in other
        for (size_type i = 0; i < size_; ++i) {
            if (is_live(i) && !other.contains(data_[i])) {
                return false;
            }
        }
        return true;
    }
    
    bool operator!=(const unordered_set& other) const {
        return !(*this == other);
    }
};

// [unord.multiset]: same storage as unordered_set, but insert never rejects an
// equivalent key, so find/count/equal_range have to scan for every match.
template<typename Key, typename Hash = esbmc_hash<Key>,
         typename KeyEqual = esbmc_equal_to<Key>,
         typename Allocator = allocator<Key>>
class unordered_multiset {
public:
    typedef Key key_type;
    typedef Key value_type;
    typedef Hash hasher;
    typedef KeyEqual key_equal;
    typedef Allocator allocator_type;
    typedef value_type& reference;
    typedef const value_type& const_reference;
    typedef value_type* pointer;
    typedef const value_type* const_pointer;
    typedef size_t size_type;
    typedef ptrdiff_t difference_type;

    typedef esbmc_unordered_set_iterator<Key, Hash, KeyEqual> iterator;
    typedef esbmc_unordered_set_iterator<Key, Hash, KeyEqual> const_iterator;

private:
    // 64 slots keeps the inline data_ array small, for the reason <unordered_map>
    // records: with std::string's inline buffer, 1024 slots made one container
    // ~140KB and solver encodings timed out.
    static const size_t MAX_SIZE = 64;
    // Erased slots stay in place, as in unordered_set above.
    Key data_[MAX_SIZE];
    size_type size_;
    size_type erased_;
    unsigned long long dead_;
    hasher hash_function_;
    key_equal equal_function_;

    size_type find_index(const Key& key) const {
        for (size_type i = 0; i < size_; ++i) {
            if (is_live(i) && equal_function_(data_[i], key)) {
                return i;
            }
        }
        return MAX_SIZE;
    }

    bool is_live(size_type i) const {
        return !((dead_ >> i) & 1);
    }

    size_type first_live(size_type i) const {
        while (i < size_ && !is_live(i)) {
            ++i;
        }
        return i;
    }

    // Only called with an erased slot, so dead_ is nonzero.
    size_type first_dead() const {
        return __builtin_ctzll(dead_);
    }

    iterator make_iterator(size_type idx) const {
        return iterator(data_, &dead_, idx, size_);
    }

    void copy_elements(const unordered_multiset& other) {
        size_ = other.size_;
        erased_ = other.erased_;
        dead_ = other.dead_;
        for (size_type i = 0; i < size_; ++i) {
            data_[i] = other.data_[i];
        }
    }

public:
    unordered_multiset() : size_(0), erased_(0), dead_(0) {}

    ~unordered_multiset() { size_ = 0; }

    explicit unordered_multiset(size_type /*bucket_count*/)
        : size_(0), erased_(0), dead_(0) {}

    unordered_multiset(std::initializer_list<value_type> init)
        : size_(0), erased_(0), dead_(0) {
        insert(init.begin(), init.end());
    }

    template<typename InputIterator>
    unordered_multiset(InputIterator first, InputIterator last)
        : size_(0), erased_(0), dead_(0) {
        insert(first, last);
    }

    unordered_multiset(const unordered_multiset& other)
        : hash_function_(other.hash_function_),
          equal_function_(other.equal_function_) {
        copy_elements(other);
    }

    unordered_multiset& operator=(const unordered_multiset& other) {
        if (this != &other) {
            hash_function_ = other.hash_function_;
            equal_function_ = other.equal_function_;
            copy_elements(other);
        }
        return *this;
    }

    iterator begin() const { return make_iterator(first_live(0)); }
    iterator end() const { return make_iterator(size_); }
    const_iterator cbegin() const { return begin(); }
    const_iterator cend() const { return end(); }

    bool empty() const { return size_ == erased_; }
    size_type size() const { return size_ - erased_; }
    size_type max_size() const { return MAX_SIZE; }

    // Unlike unordered_set::insert, an equivalent key is always added, so this
    // returns a plain iterator rather than a pair.
    iterator insert(const value_type& value) {
        size_type slot = erased_ == 0 ? size_ : first_dead();
        if (slot == size_) {
            __ESBMC_assert(size_ < MAX_SIZE, "unordered_multiset capacity exceeded");
            ++size_;
        } else {
            dead_ &= ~(1ULL << slot);
            --erased_;
        }
        data_[slot] = value;
        return make_iterator(slot);
    }

    template<typename InputIterator>
    void insert(InputIterator first, InputIterator last) {
        for (InputIterator it = first; it != last; ++it) {
            insert(*it);
        }
    }

    template<typename... Args>
    iterator emplace(Args&&... args) {
        return insert(value_type(std::forward<Args>(args)...));
    }

    // [unord.multiset] erase(k) removes every equivalent key.
    size_type erase(const key_type& key) {
        size_type removed = 0;
        for (size_type i = 0; i < size_; ++i) {
            if (is_live(i) && equal_function_(data_[i], key)) {
                dead_ |= 1ULL << i;
                ++removed;
            }
        }
        erased_ += removed;
        return removed;
    }

    void clear() { size_ = 0; erased_ = 0; dead_ = 0; }

    iterator find(const key_type& key) const {
        size_type idx = find_index(key);
        if (idx == MAX_SIZE) {
            return end();
        }
        return make_iterator(idx);
    }

    size_type count(const key_type& key) const {
        size_type n = 0;
        for (size_type i = 0; i < size_; ++i) {
            if (is_live(i) && equal_function_(data_[i], key)) {
                ++n;
            }
        }
        return n;
    }

    bool contains(const key_type& key) const {
        return find_index(key) != MAX_SIZE;
    }

    void swap(unordered_multiset& other) {
        unordered_multiset tmp = *this;
        *this = other;
        other = tmp;
    }

    hasher hash_function() const { return hash_function_; }
    key_equal key_eq() const { return equal_function_; }
};

} // namespace std

#endif // __cplusplus >= 201103L
#endif // ESBMC_UNORDERED_SET_H