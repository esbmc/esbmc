  }

  const D &get_deleter() const
  {
    return deleter;
  }

  explicit operator bool() const noexcept
  {
    return ptr != nullptr;
  }

  void swap(unique_ptr &other) noexcept
  {
    std::swap(ptr, other.ptr);
    std::swap(deleter, other.deleter);
  }
};

