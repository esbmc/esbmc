#pragma once

// Post-C++03 header: inert in older modes, matching <chrono> (#3387).
#if __cplusplus >= 201103L

#  include "cstdint"
#  include "type_traits"

namespace std
{

namespace detail
{
// Class templates, not recursive constexpr functions: the latter are also
// emitted as callable bodies that symex would unwind, though every use here is
// compile-time.
template <intmax_t A, intmax_t B>
struct static_gcd
{
  static constexpr intmax_t value = static_gcd<B, A % B>::value;
};
template <intmax_t A>
struct static_gcd<A, 0>
{
  static constexpr intmax_t value = A < 0 ? -A : A;
};
// gcd(0, 0) is taken as 1 so that reducing a sum of zero ratios never divides
// by zero; ratio<0, 0> is still rejected by ratio's own static_assert.
template <>
struct static_gcd<0, 0>
{
  static constexpr intmax_t value = 1;
};

// Compares N1/D1 < N2/D2 for non-negative numerators and positive denominators
// by continued fractions, so no cross product can overflow.
template <
  intmax_t N1,
  intmax_t D1,
  intmax_t N2,
  intmax_t D2,
  bool Swapped = false,
  bool QuotientsEqual = (N1 / D1 == N2 / D2),
  bool Remainder1Zero = (N1 % D1 == 0),
  bool Remainder2Zero = (N2 % D2 == 0)>
struct ratio_less_nonneg
{
  static constexpr bool value = Swapped ? N2 / D2 < N1 / D1 : N1 / D1 < N2 / D2;
};
template <intmax_t N1, intmax_t D1, intmax_t N2, intmax_t D2, bool S>
struct ratio_less_nonneg<N1, D1, N2, D2, S, true, true, true>
{
  static constexpr bool value = false;
};
template <intmax_t N1, intmax_t D1, intmax_t N2, intmax_t D2, bool S>
struct ratio_less_nonneg<N1, D1, N2, D2, S, true, true, false>
{
  static constexpr bool value = !S;
};
template <intmax_t N1, intmax_t D1, intmax_t N2, intmax_t D2, bool S>
struct ratio_less_nonneg<N1, D1, N2, D2, S, true, false, true>
{
  static constexpr bool value = S;
};
template <intmax_t N1, intmax_t D1, intmax_t N2, intmax_t D2, bool S>
struct ratio_less_nonneg<N1, D1, N2, D2, S, true, false, false>
{
  // Equal integer parts: compare the reciprocals of the fractional parts.
  static constexpr bool value =
    ratio_less_nonneg<D1, N1 % D1, D2, N2 % D2, !S>::value;
};

template <class R1, class R2>
struct ratio_less_impl
{
  static constexpr bool value =
    (R1::num < 0) != (R2::num < 0)
      ? R1::num < 0
      : (R1::num < 0
           ? ratio_less_nonneg<-R2::num, R2::den, -R1::num, R1::den>::value
           : ratio_less_nonneg<R1::num, R1::den, R2::num, R2::den>::value);
};
} // namespace detail

template <intmax_t Num, intmax_t Den = 1>
struct ratio
{
  static_assert(Den != 0, "ratio denominator must not be zero");
  // [ratio.ratio] p1: |Num| and |Den| must be representable in intmax_t.
  static_assert(
    Num != INTMAX_MIN && Den != INTMAX_MIN,
    "ratio argument magnitude must be representable");
  // [ratio.ratio] p1: num/den are reduced and the sign lives on num.
  static constexpr intmax_t num =
    (Den < 0 ? -Num : Num) / detail::static_gcd<Num, Den>::value;
  static constexpr intmax_t den =
    (Den < 0 ? -Den : Den) / detail::static_gcd<Num, Den>::value;
  using type = ratio<num, den>;
};

// [ratio.arithmetic]: operands are cross-reduced first, so an intermediate
// product overflows only when the reduced result itself is not representable.
template <class R1, class R2>
using ratio_multiply = typename ratio<
  (R1::num / detail::static_gcd<R1::num, R2::den>::value) *
    (R2::num / detail::static_gcd<R2::num, R1::den>::value),
  (R1::den / detail::static_gcd<R2::num, R1::den>::value) *
    (R2::den / detail::static_gcd<R1::num, R2::den>::value)>::type;
template <class R1, class R2>
using ratio_divide = ratio_multiply<R1, ratio<R2::den, R2::num>>;
namespace detail
{
// n1/d1 + n2/d2 == gn/gd * (n1/gn * d2/gd + n2/gn * d1/gd) / (d1/gd * d2/gd),
// with gn = gcd(n1, n2) and gd = gcd(d1, d2) factored out before any product.
template <class R1, class R2>
struct ratio_add_impl
{
  static constexpr intmax_t gn = static_gcd<R1::num, R2::num>::value;
  static constexpr intmax_t gd = static_gcd<R1::den, R2::den>::value;
  using type = ratio_multiply<
    ratio<gn, gd>,
    ratio<
      (R1::num / gn) * (R2::den / gd) + (R2::num / gn) * (R1::den / gd),
      (R1::den / gd) * (R2::den / gd)>>;
};
} // namespace detail

template <class R1, class R2>
using ratio_add = typename detail::ratio_add_impl<R1, R2>::type;
template <class R1, class R2>
using ratio_subtract = ratio_add<R1, ratio<-R2::num, R2::den>>;

// [ratio.comparison]
template <class R1, class R2>
struct ratio_equal
  : integral_constant<bool, R1::num == R2::num && R1::den == R2::den>
{
};
template <class R1, class R2>
struct ratio_not_equal : integral_constant<bool, !ratio_equal<R1, R2>::value>
{
};
template <class R1, class R2>
struct ratio_less
  : integral_constant<bool, detail::ratio_less_impl<R1, R2>::value>
{
};
template <class R1, class R2>
struct ratio_less_equal : integral_constant<bool, !ratio_less<R2, R1>::value>
{
};
template <class R1, class R2>
struct ratio_greater : integral_constant<bool, ratio_less<R2, R1>::value>
{
};
template <class R1, class R2>
struct ratio_greater_equal : integral_constant<bool, !ratio_less<R1, R2>::value>
{
};

#  if __cplusplus >= 201703L
template <class R1, class R2>
inline constexpr bool ratio_equal_v = ratio_equal<R1, R2>::value;
template <class R1, class R2>
inline constexpr bool ratio_not_equal_v = ratio_not_equal<R1, R2>::value;
template <class R1, class R2>
inline constexpr bool ratio_less_v = ratio_less<R1, R2>::value;
template <class R1, class R2>
inline constexpr bool ratio_less_equal_v = ratio_less_equal<R1, R2>::value;
template <class R1, class R2>
inline constexpr bool ratio_greater_v = ratio_greater<R1, R2>::value;
template <class R1, class R2>
inline constexpr bool ratio_greater_equal_v =
  ratio_greater_equal<R1, R2>::value;
#  endif

using atto = ratio<1, 1000000000000000000>;
using femto = ratio<1, 1000000000000000>;
using pico = ratio<1, 1000000000000>;
using nano = ratio<1, 1000000000>;
using micro = ratio<1, 1000000>;
using milli = ratio<1, 1000>;
using centi = ratio<1, 100>;
using deci = ratio<1, 10>;
using deca = ratio<10, 1>;
using hecto = ratio<100, 1>;
using kilo = ratio<1000, 1>;
using mega = ratio<1000000, 1>;
using giga = ratio<1000000000, 1>;
using tera = ratio<1000000000000, 1>;
using peta = ratio<1000000000000000, 1>;
using exa = ratio<1000000000000000000, 1>;

} // namespace std

#endif
