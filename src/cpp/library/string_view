#pragma once

// Post-C++03 header: inert in older modes, matching libstdc++/libc++ (#3387).
#if __cplusplus >= 201103L

#include <cstddef> /* size_t */
#include <cstdint> /* SIZE_MAX */
#include <cstring>
#include "char_traits.h"
/* Deliberately no <algorithm>: <string> includes this header, so pulling
 * <algorithm> in here would make std::for_each and friends visible to every
 * translation unit that includes <string>. Programs that define their own
 * for_each/count/... alongside `using namespace std;` then fail to compile with
 * an ambiguous call. The two helpers needed are trivial, so they are local. */

namespace std
{
namespace __sv_detail
{
inline size_t min(size_t a, size_t b)
{
  return a < b ? a : b;
}
} // namespace __sv_detail

/* [string.view.template]: string_view is basic_string_view<char>, not a class
 * of its own. Code that names the template -- boost's lexical_cast and fmt both
 * specialise on it -- did not compile while only the char instantiation
 * existed. Character access goes through Traits so a non-char instantiation
 * orders and measures its own character type. See #5868. */
template <class CharT, class Traits = char_traits<CharT>>
class basic_string_view
{
  const CharT *str;
  size_t len;

public:
  using traits_type = Traits;
  using value_type = CharT;
  using pointer = value_type *;
  using const_pointer = const value_type *;
  using reference = value_type &;
  using const_reference = const value_type &;
  using const_iterator = const_pointer;
  using iterator = const_iterator;
  using size_type = size_t;
  using difference_type = ptrdiff_t;

  static constexpr size_t npos = size_t(-1);

  // Constructors
  // [string.view.cons]: the default constructor leaves data() null, not
  // indeterminate.
  OM_CONSTEXPR basic_string_view() : str(nullptr), len(0) {}
  OM_CONSTEXPR basic_string_view(const CharT *str)
    : str(str), len(Traits::length(str))
  {
  }
  OM_CONSTEXPR basic_string_view(const CharT *str, size_t len)
    : str(str), len(len)
  {
  }

  // Iterators
  OM_CONSTEXPR const_iterator begin() const noexcept { return str; }
  OM_CONSTEXPR const_iterator cbegin() const noexcept { return str; }
  OM_CONSTEXPR const_iterator end() const noexcept { return str + len; }
  OM_CONSTEXPR const_iterator cend() const noexcept { return str + len; }

  // Capacity
  OM_CONSTEXPR size_t size() const noexcept { return len; }
  OM_CONSTEXPR size_t length() const noexcept { return len; }
  OM_CONSTEXPR size_t max_size() const noexcept { return SIZE_MAX; }
  OM_CONSTEXPR bool empty() const noexcept { return len == 0; }

  // Element access
  OM_CONSTEXPR const CharT &operator[](size_t pos) const { return str[pos]; }
  const CharT &at(size_t pos) const
  {
    /* [string.view.access]: at() throws out_of_range for pos >= size(). The
     * exception is not modelled here (see #6338 for why <string> cannot throw
     * either), so the precondition is asserted instead -- which at least
     * reports the violation rather than reading out of bounds. */
    __ESBMC_assert(pos < len, "string_view::at: pos out of range");
    return str[pos];
  }
  const CharT &front() const { return *str; }
  const CharT &back() const { return str[len - 1]; }
  OM_CONSTEXPR const CharT *data() const noexcept { return str; }

  // Modifiers
  void remove_prefix(size_t n) { str += n; len -= n; }
  void remove_suffix(size_t n) { len -= n; }
  void swap(basic_string_view &sv) noexcept
  {
    const CharT *s = str;
    size_t l = len;
    str = sv.str;
    len = sv.len;
    sv.str = s;
    sv.len = l;
  }

  // Operations
  size_t copy(CharT *dest, size_t count, size_t pos = 0) const
  {
    size_t n = __sv_detail::min(count, len - pos);
    Traits::copy(dest, str + pos, n);
    return n;
  }
  basic_string_view substr(size_t pos = 0, size_t count = npos) const
  {
    return basic_string_view(str + pos, __sv_detail::min(count, len - pos));
  }
  int compare(basic_string_view sv) const noexcept
  {
    int r = Traits::compare(str, sv.str, __sv_detail::min(len, sv.len));
    if (r)
      return r;
    if (len < sv.len)
      return -1;
    if (len > sv.len)
      return +1;
    return 0;
  }
  /* These five were declared and never defined. A declaration-only member is
   * converted as a call returning a nondeterministic value, so
   * `sv.starts_with(x)` satisfied neither the property nor its negation --
   * a silent wrong answer rather than a diagnostic. */
  bool starts_with(basic_string_view sv) const
  {
    if (sv.len > len)
      return false;
    return Traits::compare(str, sv.str, sv.len) == 0;
  }

  bool ends_with(basic_string_view sv) const
  {
    if (sv.len > len)
      return false;
    return Traits::compare(str + (len - sv.len), sv.str, sv.len) == 0;
  }

  size_t find(basic_string_view sv, size_t pos = 0) const
  {
    if (sv.len > len)
      return npos;
    for (size_t i = pos; i + sv.len <= len; ++i)
      if (Traits::compare(str + i, sv.str, sv.len) == 0)
        return i;
    return npos;
  }

  size_t find_first_of(basic_string_view sv, size_t pos = 0) const
  {
    for (size_t i = pos; i < len; ++i)
      for (size_t j = 0; j < sv.len; ++j)
        if (Traits::eq(str[i], sv.str[j]))
          return i;
    return npos;
  }

  size_t find_first_not_of(basic_string_view sv, size_t pos = 0) const
  {
    for (size_t i = pos; i < len; ++i)
    {
      bool found = false;
      for (size_t j = 0; j < sv.len; ++j)
        if (Traits::eq(str[i], sv.str[j]))
        {
          found = true;
          break;
        }
      if (!found)
        return i;
    }
    return npos;
  }

  // Non-member functions
  friend bool operator==(basic_string_view lhs, basic_string_view rhs) { return lhs.compare(rhs) == 0; }
  friend bool operator!=(basic_string_view lhs, basic_string_view rhs) { return lhs.compare(rhs) != 0; }
  friend bool operator<(basic_string_view lhs, basic_string_view rhs) { return lhs.compare(rhs) < 0; }
  friend bool operator<=(basic_string_view lhs, basic_string_view rhs) { return lhs.compare(rhs) <= 0; }
  friend bool operator>(basic_string_view lhs, basic_string_view rhs) { return lhs.compare(rhs) > 0; }
  friend bool operator>=(basic_string_view lhs, basic_string_view rhs) { return lhs.compare(rhs) >= 0; }
};

typedef basic_string_view<char> string_view;
typedef basic_string_view<wchar_t> wstring_view;
typedef basic_string_view<char16_t> u16string_view;
typedef basic_string_view<char32_t> u32string_view;
#if __cplusplus >= 202002L
typedef basic_string_view<char8_t> u8string_view;
#endif
} // namespace std

#endif // __cplusplus >= 201103L
