#ifndef ESBMC_EXECUTION
#define ESBMC_EXECUTION

// C++17 header (#7797). libc++ ships it in every language mode and expands it
// to nothing in an older one, so an unconditional include still compiles
// (#3387).
//
// The policies are the tag types and their objects only: <algorithm> and
// <numeric> here declare no overload taking an execution policy, so a
// policy-qualified call does not compile, the same way it does not when the
// toolchain's parallel algorithms are unavailable. ESBMC explores a sequential
// schedule, so a parallel overload would carry no extra behaviour anyway.
#if __cplusplus >= 201703L

#  include "type_traits"

namespace std
{
namespace execution
{
// [execpol.seq], [execpol.par], [execpol.parunseq], [execpol.unseq]. The types
// are implementation-defined, and libc++ likewise makes them empty classes.
class sequenced_policy
{
};
class parallel_policy
{
};
class parallel_unsequenced_policy
{
};

inline constexpr sequenced_policy seq{};
inline constexpr parallel_policy par{};
inline constexpr parallel_unsequenced_policy par_unseq{};

#  if __cplusplus >= 202002L
class unsequenced_policy
{
};

inline constexpr unsequenced_policy unseq{};
#  endif

} // namespace execution

// [execpol.type]
template <class T>
struct is_execution_policy : false_type
{
};

template <>
struct is_execution_policy<execution::sequenced_policy> : true_type
{
};
template <>
struct is_execution_policy<execution::parallel_policy> : true_type
{
};
template <>
struct is_execution_policy<execution::parallel_unsequenced_policy> : true_type
{
};
#  if __cplusplus >= 202002L
template <>
struct is_execution_policy<execution::unsequenced_policy> : true_type
{
};
#  endif

template <class T>
inline constexpr bool is_execution_policy_v = is_execution_policy<T>::value;

} // namespace std

#endif

#endif
