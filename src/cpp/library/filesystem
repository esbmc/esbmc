#ifndef ESBMC_FILESYSTEM
#define ESBMC_FILESYSTEM

// Post-C++03 header: inert in older modes, matching libstdc++/libc++ (#3387).
#if __cplusplus >= 201103L

#include "cstddef" /* ptrdiff_t */
#include "cstring"
#include "iterator_tags.h"
#include "string"
/* [filesystem.syn] declares an error_code& overload of nearly every
 * operation, so <filesystem> is where code expects std::error_code to
